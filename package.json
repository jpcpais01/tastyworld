{
  "name": "tastyworld",
  "private": true,
  "version": "0.10.25",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "icons": "node scripts/make-icons.mjs",
    "check:world": "tsx scripts/bake-test.ts",
    "worldmap": "npm i --no-save world-atlas@2 topojson-client@3 && node scripts/make-worldmap.mjs node_modules/world-atlas/land-50m.json",
    "check:crowd": "tsx scripts/gait-check.ts && tsx scripts/crowd-check.ts",
    "check:props": "tsx scripts/prop-check.ts"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "three": "^0.187.0",
    "trystero": "^0.25.4"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0"
  }
}
